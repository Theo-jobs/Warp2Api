# Warp2Api 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# Warp2Api 配置
# 设置为 true 启用详细日志输出，默认 false（静默模式）
W2A_VERBOSE=false

# Bridge服务器URL配置
WARP_BRIDGE_URL=http://127.0.0.1:28888

# API Token认证 - 用于保护对外接口
# 请设置一个安全的token，不要使用默认值！
API_TOKEN=001

# Warp认证相关
# 从Warp应用中获取的刷新token
WARP_REFRESH_TOKEN=your_warp_refresh_token_here

# JWT token（可选，通常会自动获取）
# WARP_JWT=your_warp_jwt_token_here

# Firebase token 刷新配置（从 settings.py 外移）
WARP_REFRESH_TOKEN_B64=your_base64_encoded_refresh_token_here
FIREBASE_API_KEY=your_firebase_api_key_here

# 网络代理配置
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
NO_PROXY=127.0.0.1,localhost

# 部署脚本凭据（deploy.sh 使用）
# DEPLOY_SSH_HOST=your_ssh_host
# DEPLOY_SSH_PORT=10000
# DEPLOY_SSH_USER=your_ssh_user
# DEPLOY_SSH_PASS=your_ssh_password

# 说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 必须设置 API_TOKEN 为安全的token
# 3. WARP_REFRESH_TOKEN 需要从Warp应用中获取
# 4. WARP_REFRESH_TOKEN_B64 和 FIREBASE_API_KEY 用于 token 刷新
# 5. DEPLOY_* 变量仅部署时需要
# 6. 其他配置根据需要调整